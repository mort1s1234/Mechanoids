rwtest 1
test "Gestator amplifier speeds adjacent gestators, two at most" project="Apex Mechanoids" created=2026-11-17T00:00:00

requires mod=Mortis.ApexMechanoids
requires dlc=Biotech
research StandardMechtech done=true
spawn Thing:LargeMechGestator at 0,0 faction=player name="large gestator"
spawn Thing:MechGestator at -12,0 faction=player name="lone gestator"

infocard "large gestator"
window Dialog_InfoCard
assert window Dialog_InfoCard contains "Mech gestation speed factor" expect=absent
key Cancel

spawn Thing:APM_GestatorAmplifier at -1,2 faction=player name="first amplifier"
infocard "large gestator"
window Dialog_InfoCard
assert window Dialog_InfoCard contains "Mech gestation speed factor" expect=present
assert window Dialog_InfoCard contains "120%" expect=present
assert text contains "APM_" expect=absent
key Cancel

spawn Thing:APM_GestatorAmplifier at 1,2 faction=player name="second amplifier"
spawn Thing:APM_GestatorAmplifier at -3,2 faction=player name="third amplifier"
infocard "large gestator"
window Dialog_InfoCard
assert window Dialog_InfoCard contains "140%" expect=present
assert window Dialog_InfoCard contains "160%" expect=absent
key Cancel

infocard "lone gestator"
window Dialog_InfoCard
assert window Dialog_InfoCard contains "Mech gestation speed factor" expect=absent
key Cancel

select "large gestator"
tab "Bills"
click "Add bill"
menu "Gestate tunneler" expect=allowed
deselect
assert log clean
requires assert=bill
assert bill "large gestator" recipe=Tunneler workspeed min=1.39 max=1.41
