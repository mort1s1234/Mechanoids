<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<WorkGiverDef>
		<defName>APM_EnterRepairStation</defName>
		<label>enter repair station</label>
		<giverClass>ApexMechanoids.WorkGiver_EnterRepairStation</giverClass>
		<workType>BasicWorker</workType>
		<priorityInType>100</priorityInType>
		<verb>enter</verb>
		<gerund>entering</gerund>
		<requiredCapacities>
			<li>Moving</li>
		</requiredCapacities>
	</WorkGiverDef>
	<WorkGiverDef>
		<defName>APM_CarryToRepairStation</defName>
		<label>carry to repair station</label>
		<giverClass>ApexMechanoids.WorkGiver_CarryToRepairStation</giverClass>
		<workType>Hauling</workType>
		<priorityInType>60</priorityInType>
		<verb>carry</verb>
		<gerund>carrying</gerund>
		<requiredCapacities>
			<li>Manipulation</li>
		</requiredCapacities>
	</WorkGiverDef>
	<!--
		Mechanoids before anything else the tinker could be doing. A wall at half hit points costs the
		colony nothing until something walks through it; a mech at half hit points loses the next
		fight, and the tinker is the only thing that can put one back together in the field.

		Two things say so. The priority puts it above repair building, which used to outrank it at 230
		and is why a tinker with a damaged squad around it went and patched masonry. The emergency
		flag puts it in the list JobGiver_Work walks before it touches ordinary work at all, so it
		stays first even if the tinker is ever given a second work type to do.
	-->
	<WorkGiverDef>
		<defName>APM_TinkerRepairMech</defName>
		<label>repair mech</label>
		<giverClass>ApexMechanoids.WorkGiver_TinkerRepairMech</giverClass>
		<workType>APM_TinkerRepair</workType>
		<verb>repair</verb>
		<gerund>repairing</gerund>
		<priorityInType>240</priorityInType>
		<emergency>true</emergency>
		<requiredCapacities>
			<li>Manipulation</li>
		</requiredCapacities>
		<canBeDoneByMechs>true</canBeDoneByMechs>
		<canBeDoneWhileDrafted>false</canBeDoneWhileDrafted>
	</WorkGiverDef>
	<WorkGiverDef>
		<defName>APM_TinkerRepairBuilding</defName>
		<label>repair building</label>
		<giverClass>ApexMechanoids.WorkGiver_TinkerRepairBuilding</giverClass>
		<workType>APM_TinkerRepair</workType>
		<verb>repair</verb>
		<gerund>repairing</gerund>
		<priorityInType>230</priorityInType>
		<requiredCapacities>
			<li>Manipulation</li>
		</requiredCapacities>
		<canBeDoneByMechs>true</canBeDoneByMechs>
		<canBeDoneWhileDrafted>false</canBeDoneWhileDrafted>
	</WorkGiverDef>
  <WorkGiverDef ParentName="HaulToBase">
    <defName>APM_HaulToToxicPurifier</defName>
    <label>haul wastepacks to purifier station</label>
    <giverClass>ApexMechanoids.WorkGiver_HaulToToxicPurifier</giverClass>
  </WorkGiverDef>
</Defs>
