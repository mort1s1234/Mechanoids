rwtest 1
test "Flash, beam and Solus lightning effects look right" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires mod=Mortis.ApexMechanoids
requires dlc=Biotech
spawn Pawn:Colonist at -4,-8 name="Mechanitor"
draft "Mechanitor"
spawn Pawn:Colonist at 0,-12 name="Gazer mechanitor"
draft "Gazer mechanitor"
spawn Pawn:APM_Mech_Pulse at -10,0 faction=player name="Pulse" rolled=true
spawn Pawn:Colonist at -7,0 name="Pulse target"
draft "Pulse target"
overseer "Pulse" by="Mechanitor" now=true
select "Pulse"
gizmo "Pulse wave" expect=allowed
deselect
ask "pulse-wave" ticks=132 claim="a warm white flash bursts from the Pulse mech and a wave expands outwards over the colonist next to it; the flash is not a hard white square"

spawn Pawn:APM_Mech_Tinker at 0,6 faction=player name="Tinker" rolled=true
spawn Pawn:Colonist at 5,6 name="Laser target"
draft "Laser target"
overseer "Tinker" by="Mechanitor" now=true
select "Tinker"
gizmo "Blinding Laser" expect=allowed
target "Laser target" expect=allowed
deselect
ask "blinding-laser" ticks=66 claim="a thin laser beam connects the Tinker to the colonist it aims at, starting at the Tinker and ending on the colonist's head, not somewhere beside them"

spawn Pawn:APM_Mech_Gazer at 10,-6 faction=player name="Gazer" rolled=true
spawn Pawn:Colonist at 13,-6 name="Thrown"
draft "Thrown"
overseer "Gazer" by="Gazer mechanitor" now=true
select "Gazer"
gizmo "Shockwave" expect=allowed
deselect
ask "shockwave" ticks=360 claim="the Gazer charges, a pale warm flash goes off, a blast wave travels outward, and the colonist in it is thrown away through the air and lands several cells away"
despawn Pawn:APM_Mech_Pulse
despawn Pawn:APM_Mech_Tinker
despawn Pawn:APM_Mech_Gazer
despawn Pawn:Colonist

room at -1,-3 size=15,7 door=none roof=false name="range"
spawn Pawn:Colonist at 0,0 name="Gunner"
draft "Gunner"
spawn Pawn:Colonist at 12,1 faction=enemy name="Raider A"
spawn Pawn:Colonist at 12,0 faction=enemy name="Raider B"
spawn Pawn:Colonist at 12,-1 faction=enemy name="Raider C"
equip "Gunner" thing=APM_Solus now=true
assert pawn "Gunner" equipment=APM_Solus expect=present
attack "Gunner" target="Raider B"
ask "solus-orb" ticks=480 claim="after a long charge the gunner fires a glowing orb at the middle raider; when it hits, golden lightning jumps from it to the raiders next to it; the lightning is gold, not white or pink"
undraft "Gunner"
assert log clean
