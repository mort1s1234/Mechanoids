rwtest 1
test "Unity grows with conqueror allies" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
spawn Pawn:APM_Mech_Conqueror_DMR name="DMR"
pacify "DMR"
tick 600 note="two 250 tick recount intervals from a random offset"
assert pawn "DMR" hediff=APM_Hediff_Unity expect=present
assert pawn "DMR" hediff=APM_Hediff_Unity severity max=0.05 expect=present
assert pawn "DMR" stat=MoveSpeed min=4.25 max=4.32 expect=present

spawn Pawn:APM_Mech_Conqueror_SMG faction=player name="Colony SMG"
pacify "Colony SMG"
tick 600 note="two recount intervals; a colony Conqueror is no ally of a hostile one"
assert pawn "DMR" hediff=APM_Hediff_Unity severity max=0.05 expect=present

spawn Pawn:APM_Mech_Conqueror_AR name="AR"
pacify "AR"
spawn Pawn:APM_Mech_Conqueror_SMG name="SMG"
pacify "SMG"
waitfor pawn "DMR" hediff=APM_Hediff_Unity severity min=0.19 max=0.21 ticks=500 expect=present
waitfor pawn "AR" hediff=APM_Hediff_Unity severity min=0.19 max=0.21 ticks=500 expect=present
assert pawn "DMR" stat=MoveSpeed min=4.33 max=4.40 expect=present
assert log clean
