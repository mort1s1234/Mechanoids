rwtest 1
test "Mantis repairs itself after a kill and not without one" project="Apex Mechanoids" created=2026-10-02T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
speed paused
spawn Pawn:APM_Mech_Mantis faction=player name="Hunter"
spawn Pawn:APM_Mech_Mantis faction=player name="Idle"
spawn Pawn:Mech_Scyther name="Prey" gear=none
speed x1
waitfor pawn "Hunter" hediff=APM_ApexMechanoid_HealOnKills ticks=60 expect=present
waitfor pawn "Idle" hediff=APM_ApexMechanoid_HealOnKills ticks=60 expect=present
speed paused
damage "Prey" amount=999 kind=Burn by="Hunter"
assert pawn "Prey" dead expect=present
damage "Hunter" amount=100 kind=Burn
damage "Idle" amount=100 kind=Burn
assert pawn "Hunter" hediff=Burn severity min=99 max=101 expect=present
assert pawn "Idle" hediff=Burn severity min=99 max=101 expect=present
tick 300 note="5 repair pulses, one every 60 ticks, the first on the first tick"
assert pawn "Hunter" hediff=Burn severity min=70 max=80 expect=present
assert pawn "Idle" hediff=Burn severity min=99 max=101 expect=present
reload note="the banked charges are saved on the hediff"
tick 300 note="5 more repair pulses"
assert pawn "Hunter" hediff=Burn severity min=45 max=55 expect=present
assert pawn "Idle" hediff=Burn severity min=99 max=101 expect=present
assert log clean
