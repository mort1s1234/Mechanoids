rwtest 1
test "Duel winner patches up part of its wounds" project="Apex Mechanoids" created=2026-10-02T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
speed paused
spawn Pawn:Colonist at 0,0 name="Duelist" gear=none xenotype=Baseliner
spawn Pawn:Colonist at 4,0 faction=enemy name="Raider" gear=none xenotype=Baseliner
equip "Duelist" thing=APM_Weapon_DuelistsPsySpear now=true
assert pawn "Duelist" stat=IncomingDamageFactor min=0.99 max=1.01 expect=present
assert pawn "Raider" stat=IncomingDamageFactor min=0.99 max=1.01 expect=present
damage "Duelist" amount=20 kind=Burn part=Torso
damage "Raider" amount=20 kind=Burn part=Torso
assert pawn "Duelist" hediff=Burn severity min=19 max=21 expect=present
assert pawn "Raider" hediff=Burn severity min=19 max=21 expect=present
select "Duelist"
gizmo "The duel trial" expect=allowed
target "Raider" expect=allowed
deselect
speed x1
waitfor pawn "Duelist" hediff=APM_InDuel ticks=240 expect=present
speed paused
assert pawn "Duelist" hediff=Burn severity min=19 max=21 expect=present
down "Raider"
speed x1
waitfor pawn "Duelist" hediff=APM_DuelWinner ticks=60 expect=present
speed paused
assert pawn "Duelist" hediff=Burn severity min=11 max=13 expect=present
assert pawn "Raider" hediff=Burn severity min=19 max=21 expect=present
assert log clean
