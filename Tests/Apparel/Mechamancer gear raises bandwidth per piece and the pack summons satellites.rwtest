rwtest 1
test "Mechamancer gear raises bandwidth per piece and the pack summons satellites" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires mod=Mortis.ApexMechanoids
requires dlc=Biotech
spawn Pawn:Colonist name="Mechanitor"
spawn Pawn:Mech_Lifter faction=player name="Lifter"
overseer "Lifter" by="Mechanitor" now=true
assert pawn "Mechanitor" hediff=MechlinkImplant expect=present
assert pawn "Mechanitor" stat=MechBandwidth min=5.9 max=6.1 expect=present

wear "Mechanitor" apparel=APM_Apparel_MechamancerSuit
assert pawn "Mechanitor" apparel=APM_Apparel_MechamancerSuit expect=present
assert pawn "Mechanitor" stat=MechBandwidth min=29.9 max=30.1 expect=present
assert statpart "Mechanitor" stat=PainShockThreshold from=APM_Apparel_MechamancerSuit offset min=0.04 max=0.06

wear "Mechanitor" apparel=APM_Apparel_ArmorHelmetMechamancerHelmet
assert pawn "Mechanitor" apparel=APM_Apparel_ArmorHelmetMechamancerHelmet expect=present
assert pawn "Mechanitor" stat=MechBandwidth min=43.9 max=44.1 expect=present

wear "Mechanitor" apparel=APM_Apparel_MechamancerPack
assert pawn "Mechanitor" apparel=APM_Apparel_MechamancerPack expect=present
assert pawn "Mechanitor" apparel=APM_Apparel_MechamancerSuit expect=present
assert pawn "Mechanitor" stat=MechBandwidth min=61.9 max=62.1 expect=present

spawn Pawn:Colonist name="Packer"
wear "Packer" apparel=APM_Apparel_MechamancerPack
assert thing APM_Mech_Satellite expect=absent

select "Packer"
gizmo "summon satellite" expect=allowed
waitfor thing APM_Mech_Satellite ticks=180 expect=present
select "Packer"
gizmo "summon satellite" expect=allowed
tick 180 note="second use: 60 tick warmup plus the cast job"

select "Packer"
gizmo "summon satellite" expect=refused
assert text contains "APM" expect=absent
deselect
assert log clean
