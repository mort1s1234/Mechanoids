rwtest 1
test "Search and Destroy - apex mechs skip listed abilities, Tinker keeps repairing" project="Apex Mechanoids" created=2026-11-17T00:00:00

requires mod=Mortis.ApexMechanoids
requires dlc=Biotech
requires mod=MemeGoddess.SearchAndDestroy
spawn Pawn:Colonist at -6,0 name="Mechanitor" drafted=true
spawn Pawn:APM_Mech_Tinker at -2,-4 faction=player name="Tinker" drafted=true
spawn Pawn:Mech_Lifter at -2,-6 faction=player name="Patient" drafted=true
overseer "Tinker" by="Mechanitor" now=true
overseer "Patient" by="Mechanitor" now=true
damage "Patient" amount=10 kind=Blunt
tick 600 note="a drafted Tinker without Search and Destroy takes no work; ten seconds of drafted idling"
assert jobhistory "Tinker" job=APM_RepairMech expect=absent
assert pawn "Patient" hediff=Crack expect=present

select "Tinker"
gizmo "Search and Destroy" expect=allowed
deselect
waitfor jobhistory "Tinker" job=APM_RepairMech ticks=1200 expect=present
waitfor pawn "Patient" hediff=Crack expect=absent ticks=2500

spawn Pawn:APM_Mech_Celerus at 0,6 faction=player name="Celerus" drafted=true
overseer "Celerus" by="Mechanitor" now=true
spawn Pawn:Mech_Militor at 10,6 faction=enemy name="Foe" drafted=true
select "Celerus"
gizmo "Search and Destroy" expect=allowed
deselect
waitfor hit "Foe" by="Celerus" min=1 ticks=1500
assert casts "Celerus" ability=APM_CelerusBlink min=0 max=0
assert casts "Celerus" ability=APM_Ability_SmokeScreen min=0 max=0
assert text contains "APM_" expect=absent
assert log clean
