rwtest 1
test "Repair station, gazer emplacement, purifier, stasis container and command casket" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires mod=Mortis.ApexMechanoids
requires dlc=Biotech
sky glow=1
room size=13,9 roof=false name="station yard"
spawn Thing:WoodFiredGenerator in="station yard" faction=player fueled=true
spawn Thing:APM_RepairStation_Small in="station yard" faction=player name="station"
spawn Pawn:Mech_Lifter in="station yard" faction=player name="Repairee"
waitfor power "station" ticks=250 expect=present

damage "Repairee" amount=10 kind=Blunt
assert pawn "Repairee" hediff=Crack expect=present

select "station"
gizmo "Insert mech..." expect=allowed
menu "Repairee" expect=allowed
assert text contains "APM_" expect=absent
deselect
waitfor inspect "station" contains "Repairing" ticks=1500 expect=present
waitfor pawn "Repairee" hediff=Crack expect=absent ticks=2500

select "station"
gizmo "Insert mech..." expect=allowed
menu "Repairee" expect=absent
menu "No mechs available." expect=disabled

room at 30,-4 size=13,9 roof=false name="emplacement yard"
spawn Thing:APM_GazerEmplacement in="emplacement yard" faction=player name="emplacement"
select "emplacement"
gizmo "Sun Ray" expect=disabled reason="No power." match=equals
deselect

spawn Thing:WoodFiredGenerator in="emplacement yard" faction=player fueled=true
waitfor power "emplacement" ticks=250 expect=present
select "emplacement"
gizmo "Sun Ray" expect=disabled reason="Needs an operator." match=equals
assert text contains "APM." expect=absent
deselect
assert inspect "emplacement" contains "Status: Ready" expect=present

spawn Thing:APM_Building_ToxicPurifier at -40,25 faction=player name="purifier"
assert inspect "purifier" contains "0 / 15" expect=present

select "purifier"
gizmo "Mode: Wastepacks only" expect=absent
gizmo "Mode: Ground over wastepacks" expect=allowed
menu "Wastepacks only" expect=allowed
assert text contains "APM_" expect=absent
select "purifier"
gizmo "Mode: Ground over wastepacks" expect=absent
gizmo "Mode: Wastepacks only" expect=allowed
menu "Wastepacks only" expect=allowed
deselect

reload note="the purifier mode is saved on the comp"
select "purifier"
gizmo "Mode: Ground over wastepacks" expect=absent
gizmo "Mode: Wastepacks only" expect=allowed
menu "Wastepacks only" expect=allowed
deselect

room at 30,20 size=13,9 roof=false name="container yard"
spawn Thing:APM_MechanoidContainer_Player in="container yard" faction=player name="container"
spawn Pawn:APM_Mech_Lasher in="container yard" faction=player name="Lasher"
assert inspect "container" contains "Contains nobody." expect=present

select "container"
gizmo "Choose mechanoid" expect=disabled reason="No power" match=equals
deselect

spawn Thing:WoodFiredGenerator in="container yard" faction=player fueled=true
waitfor power "container" ticks=250 expect=present

select "container"
gizmo "Choose mechanoid" expect=allowed
target "Lasher" expect=allowed
assert text contains "APM." expect=absent
deselect
waitfor inspect "container" contains "Contains nobody." expect=absent ticks=1500
assert inspect "container" contains "Contains" expect=present
assert inspect "container" contains "unidentified" expect=absent

reload note="the mech is kept in the container's saved innerContainer"
assert inspect "container" contains "Contains nobody." expect=absent
assert inspect "container" contains "Contains" expect=present

room at -60,-5 size=15,11 roof=false name="casket yard"
spawn Thing:WoodFiredGenerator at -53,1 faction=player fueled=true
spawn Thing:APM_MechCommandCasket in="casket yard" faction=player name="casket"
spawn Pawn:Colonist in="casket yard" name="Mechanitor"
spawn Pawn:Colonist in="casket yard" name="Plain"
spawn Pawn:Mech_Lifter in="casket yard" faction=player name="Lifter"
spawn Pawn:APM_Mech_Aegis in="casket yard" faction=player name="Aegis"
waitfor power "casket" ticks=250 expect=present

ordermenu "Plain" on="casket"
menu "Cannot enter command casket: Not mechanitor" expect=disabled
menu "Enter command casket" expect=absent

overseer "Lifter" by="Mechanitor" now=true
assert pawn "Mechanitor" hediff=MechlinkImplant expect=present
overseer "Aegis" by="Mechanitor" now=true
give "Mechanitor" hediff=RemoteRepairerImplant severity=1 part=Brain

ordermenu "Mechanitor" on="casket"
menu "Enter command casket" expect=allowed
waitfor inspect "casket" contains "Contains:" ticks=2500 expect=present
assert text contains "APM." expect=absent
reload note="the casket user and its nutrition are saved"
assert inspect "casket" contains "Contains:" expect=present

give "Aegis" need=MechEnergy value=0.5
damage "Aegis" amount=20 kind=Burn
select "Mechanitor"
gizmo "remote repair" expect=allowed
target "Aegis" expect=allowed
waitfor pawn "Aegis" hediff=Burn expect=absent ticks=6000
assert pawn "Aegis" need=MechEnergy min=0.42 max=0.47 expect=present

give "Aegis" need=MechEnergy value=0.5
damage "Aegis" amount=20 kind=Burn part=APM_AegisShield
select "Mechanitor"
gizmo "remote repair" expect=allowed
target "Aegis" expect=allowed
waitfor pawn "Aegis" hediff=Burn expect=absent ticks=6000
assert pawn "Aegis" need=MechEnergy min=0.29 max=0.35 expect=present
assert log clean
