rwtest 1
test "Terminus overdrive hardens its strikes" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires mod=Mortis.ApexMechanoids
requires dlc=Biotech
spawn Pawn:APM_Mech_Terminus faction=player name="Terminus"
spawn Pawn:Colonist name="Mechanitor"
draft "Mechanitor"
overseer "Terminus" by="Mechanitor" now=true
draft "Terminus"

assert pawn "Terminus" stat=MeleeDamageFactor min=0.95 max=1.05 expect=present
assert pawn "Terminus" stat=MeleeCooldownFactor min=0.95 max=1.05 expect=present
select "Terminus"
gizmo "Overdrive" expect=allowed

waitfor pawn "Terminus" hediff=APM_Hediff_TerminusOverdrive ticks=240 expect=present
assert pawn "Terminus" stat=MeleeDamageFactor min=1.55 max=1.65 expect=present
assert pawn "Terminus" stat=MeleeCooldownFactor min=0.6 max=0.7 expect=present
assert pawn "Terminus" capacity=Moving min=1.2 max=1.3 expect=present
gizmo "Overdrive" expect=disabled
deselect

reload note="the overdrive is a saved hediff with a timer, and the cooldown is saved ability state"
assert pawn "Terminus" stat=MeleeDamageFactor min=1.55 max=1.65 expect=present
select "Terminus"
gizmo "Overdrive" expect=disabled
deselect
assert log clean
