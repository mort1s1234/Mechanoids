rwtest 1
test "Tinker laser blinds eyes not mechs, defence matrix only onto its own side" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires mod=Mortis.ApexMechanoids
requires dlc=Biotech
speed paused
room at -1,-3 size=9,7 door=none roof=false name="range"
spawn Pawn:APM_Mech_Tinker at 0,0 faction=player name="Tinker"
spawn Pawn:Colonist at 5,0 name="Target"
draft "Target"
spawn Pawn:Mech_Lifter at 5,2 faction=player name="Lifter"
spawn Pawn:Colonist at 0,2 name="Far"
draft "Far"
spawn Pawn:Colonist at 0,-2 name="Mechanitor"
draft "Mechanitor"
overseer "Tinker" by="Mechanitor" now=true
assert pawn "Target" capacity=Sight min=0.95 expect=present
assert pawn "Far" capacity=Sight min=0.95 expect=present

select "Tinker"
gizmo "Blinding Laser" expect=allowed
target "Target" expect=allowed
speed x1
deselect
waitfor pawn "Target" hediff=APM_LaserBlind ticks=180 expect=present
assert pawn "Target" capacity=Sight max=0.06 expect=present
assert pawn "Lifter" hediff=APM_LaserBlind expect=absent
assert pawn "Far" hediff=APM_LaserBlind expect=absent
assert pawn "Far" capacity=Sight min=0.95 expect=present

speed paused
spawn Pawn:APM_Mech_Tinker at 40,0 faction=player name="Matrix tinker"
spawn Pawn:Colonist at 37,-2 name="Matrix mechanitor" gear=none
draft "Matrix mechanitor"
give "Matrix mechanitor" need=Food value=1
overseer "Matrix tinker" by="Matrix mechanitor" now=true
draft "Matrix tinker"
spawn Pawn:Colonist at 45,0 name="Ally"
draft "Ally"
spawn Pawn:Colonist at 40,5 faction=enemy name="Foe"

select "Matrix tinker"
gizmo "Defence Matrix" expect=allowed
target "Foe" expect=refused
assert thing MechShield expect=absent
down "Foe"

gizmo "Defence Matrix" expect=allowed
target "Ally" expect=allowed
deselect
speed x1
waitfor thing MechShield at 45,0 ticks=120 expect=present
assert thing MechShield at 40,5 expect=absent
undraft "Matrix tinker"
assert log clean
