rwtest 1
test "Siren lure refuses mechs, the downed and the recently lured" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
spawn Pawn:APM_Mech_Siren at 0,0 faction=player name="Lure"
spawn Pawn:APM_Mech_Siren at 0,4 faction=player name="Second"
spawn Pawn:Colonist at -2,0 name="Mechanitor"
draft "Mechanitor"
spawn Pawn:Colonist at 8,0 name="Lured"
spawn Pawn:Colonist at -8,0 name="Fresh"
spawn Pawn:Colonist at 6,6 name="Fallen"
spawn Pawn:APM_Mech_Tinker at 0,-6 faction=player name="Tin"
overseer "Lure" by="Mechanitor" now=true
overseer "Second" by="Mechanitor" now=true
draft "Lure"
draft "Second"
down "Fallen"
assert pawn "Fallen" downed expect=present

select "Lure"
gizmo "Aluring Song" expect=allowed
target "Tin" expect=refused
gizmo "Aluring Song" expect=allowed
target "Fallen" expect=refused
assert pawn "Lured" hediff=APM_Hediff_SirenLureCooldown expect=absent

gizmo "Aluring Song" expect=allowed
target "Lured" expect=allowed
deselect
waitfor pawn "Lured" hediff=APM_Hediff_SirenLureCooldown ticks=150 expect=present
assert pawn "Lured" job=GotoMindControlled expect=present
assert pawn "Lure" job=APM_SirenLureChannel expect=present

waitfor pawn "Lured" job=GotoMindControlled ticks=700 expect=absent
assert pawn "Lured" hediff=APM_Hediff_SirenLureCooldown expect=present

select "Second"
gizmo "Aluring Song" expect=allowed
target "Lured" expect=refused
gizmo "Aluring Song" expect=allowed
target "Fresh" expect=allowed
deselect
waitfor pawn "Fresh" hediff=APM_Hediff_SirenLureCooldown ticks=150 expect=present
assert pawn "Tin" hediff=APM_Hediff_SirenLureCooldown expect=absent
assert pawn "Fallen" hediff=APM_Hediff_SirenLureCooldown expect=absent
assert log clean
