rwtest 1
test "Pulse wave blinds flesh in its radius, longjump lands short of the minimum" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires mod=Mortis.ApexMechanoids
requires dlc=Biotech
spawn Pawn:APM_Mech_Pulse at 0,0 faction=player name="Pulse"
spawn Pawn:Colonist at 3,0 name="Near"
draft "Near"
spawn Pawn:Colonist at 10,0 name="Far"
draft "Far"
spawn Pawn:APM_Mech_Tinker at 0,3 faction=player name="Tin"
spawn Pawn:Colonist at -10,-6 name="Mechanitor"
draft "Mechanitor"
overseer "Pulse" by="Mechanitor" now=true
draft "Pulse"

assert pawn "Near" capacity=Sight min=0.95 expect=present
assert thing "Near" at 3,0 expect=present

select "Pulse"
gizmo "Pulse wave" expect=allowed
deselect
waitfor pawn "Near" hediff=APM_PulseWaveBlind ticks=300 expect=present
assert pawn "Near" capacity=Sight max=0.21 expect=present
tick 120 note="let the wave finish past its 6.9 cell radius"

assert pawn "Far" hediff=APM_PulseWaveBlind expect=absent
assert pawn "Far" capacity=Sight min=0.95 expect=present
assert pawn "Tin" hediff=APM_PulseWaveBlind expect=absent

spawn Pawn:APM_Mech_Pulse at 40,0 faction=player name="Jumper"
spawn Pawn:Colonist at 37,-2 name="Jumper mechanitor"
draft "Jumper mechanitor"
give "Jumper mechanitor" need=Food value=1
overseer "Jumper" by="Jumper mechanitor" now=true
draft "Jumper"

select "Jumper"
gizmo "Mech longjump" expect=allowed
target cell=54,0 expect=refused
assert thing "Jumper" at 40,0 expect=present

assert thing "Jumper" at 44,0 expect=absent
gizmo "Mech longjump" expect=allowed
target cell=44,0 expect=allowed
deselect
waitfor thing "Jumper" at 44,0 ticks=300 expect=present
assert thing "Jumper" at 40,0 expect=absent
undraft "Jumper"
assert log clean
