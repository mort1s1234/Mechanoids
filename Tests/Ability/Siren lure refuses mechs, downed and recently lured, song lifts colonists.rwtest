rwtest 1
test "Siren lure refuses mechs, downed and recently lured, song lifts colonists" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires mod=Mortis.ApexMechanoids
requires dlc=Biotech
spawn Pawn:APM_Mech_Siren at 0,0 faction=player name="Lure"
spawn Pawn:APM_Mech_Siren at 0,4 faction=player name="Second"
spawn Pawn:Colonist at -2,0 name="Mechanitor"
draft "Mechanitor"
spawn Pawn:Colonist at 8,0 name="Lured"
spawn Pawn:Colonist at -8,0 name="Fresh"
spawn Pawn:Colonist at 6,6 name="Fallen"
spawn Pawn:APM_Mech_Tinker at 0,-6 faction=player name="Tin"
overseer "Lure" by="Mechanitor" now=true
overseer "Second" by="Mechanitor" now=true
draft "Lure"
draft "Second"
down "Fallen"
assert pawn "Fallen" downed expect=present

select "Lure"
gizmo "Aluring Song" expect=allowed
target "Tin" expect=refused
gizmo "Aluring Song" expect=allowed
target "Fallen" expect=refused
assert pawn "Lured" hediff=APM_Hediff_SirenLureCooldown expect=absent

gizmo "Aluring Song" expect=allowed
target "Lured" expect=allowed
deselect
waitfor pawn "Lured" hediff=APM_Hediff_SirenLureCooldown ticks=150 expect=present
assert pawn "Lured" job=GotoMindControlled expect=present
assert pawn "Lure" job=APM_SirenLureChannel expect=present

waitfor pawn "Lured" job=GotoMindControlled ticks=700 expect=absent
assert pawn "Lured" hediff=APM_Hediff_SirenLureCooldown expect=present

select "Second"
gizmo "Aluring Song" expect=allowed
target "Lured" expect=refused
gizmo "Aluring Song" expect=allowed
target "Fresh" expect=allowed
deselect
waitfor pawn "Fresh" hediff=APM_Hediff_SirenLureCooldown ticks=150 expect=present
assert pawn "Tin" hediff=APM_Hediff_SirenLureCooldown expect=absent
assert pawn "Fallen" hediff=APM_Hediff_SirenLureCooldown expect=absent

spawn Pawn:APM_Mech_Siren at 0,30 faction=player name="Singer"
spawn Pawn:Colonist at 0,28 name="Singer mechanitor"
draft "Singer mechanitor"
spawn Pawn:Colonist at 4,30 name="Near" gear=none
draft "Near"
spawn Pawn:Colonist at 15,30 name="Far" gear=none
draft "Far"
overseer "Singer" by="Singer mechanitor" now=true
draft "Singer"
give "Near" need=Joy value=0.3
give "Far" need=Joy value=0.3

assert pawn "Near" capacity=Moving min=0.95 max=1.02 expect=present
assert pawn "Near" capacity=Consciousness min=0.95 max=1.02 expect=present

select "Singer"
gizmo "Siren's song" expect=allowed
deselect

waitfor pawn "Near" hediff=APM_Hediff_SirenSong ticks=180 expect=present
assert pawn "Near" need=Joy min=0.48 max=0.52 expect=present
assert pawn "Near" capacity=Moving min=1.07 max=1.13 expect=present
assert pawn "Near" capacity=Consciousness min=1.02 max=1.08 expect=present
waitfor pawn "Near" thought=APM_Thought_SirenSong ticks=300 expect=present
assert thoughtpart "Near" thought=APM_Thought_SirenSong min=5.9 max=6.1 expect=present

assert pawn "Far" hediff=APM_Hediff_SirenSong expect=absent
assert pawn "Far" need=Joy max=0.32 expect=present
assert pawn "Far" capacity=Moving max=1.02 expect=present
assert pawn "Far" thought=APM_Thought_SirenSong expect=absent
assert pawn "Singer" hediff=APM_Hediff_SirenSong expect=absent
assert log clean
