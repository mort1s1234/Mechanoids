rwtest 1
test "Dynamo turns into a power plant and back" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
spawn Pawn:APM_Mech_Dynamo faction=player name="Dynamo"
spawn Pawn:Colonist name="Mechanitor"
draft "Mechanitor"
overseer "Dynamo" by="Mechanitor" now=true
assert thing APM_DynamoPoweredGenerator expect=absent

select "Dynamo"
gizmo "Power Plant Mode" expect=allowed
deselect
waitfor thing APM_DynamoPoweredGenerator ticks=480 expect=present

reload note="the Dynamo is kept in the generator's saved container"
assert thing APM_DynamoPoweredGenerator expect=present
select APM_DynamoPoweredGenerator
gizmo "Mobile Mode" expect=allowed
assert text contains "APM" expect=absent

waitfor thing APM_DynamoPoweredGenerator ticks=120 expect=absent
assert pawn "Dynamo" downed expect=absent
assert log clean
