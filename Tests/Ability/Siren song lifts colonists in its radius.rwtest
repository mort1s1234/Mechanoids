rwtest 1
test "Siren song lifts colonists in its radius" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
spawn Pawn:APM_Mech_Siren at 0,0 faction=player name="Siren"
spawn Pawn:Colonist at 0,-2 name="Mechanitor"
draft "Mechanitor"
spawn Pawn:Colonist at 4,0 name="Near" gear=none
draft "Near"
spawn Pawn:Colonist at 15,0 name="Far" gear=none
draft "Far"
overseer "Siren" by="Mechanitor" now=true
draft "Siren"
give "Near" need=Joy value=0.3
give "Far" need=Joy value=0.3

assert pawn "Near" capacity=Moving min=0.95 max=1.02 expect=present
assert pawn "Near" capacity=Consciousness min=0.95 max=1.02 expect=present

select "Siren"
gizmo "Siren's song" expect=allowed
deselect

waitfor pawn "Near" hediff=APM_Hediff_SirenSong ticks=180 expect=present
assert pawn "Near" need=Joy min=0.48 max=0.52 expect=present
assert pawn "Near" capacity=Moving min=1.07 max=1.13 expect=present
assert pawn "Near" capacity=Consciousness min=1.02 max=1.08 expect=present
waitfor pawn "Near" thought=APM_Thought_SirenSong ticks=300 expect=present
assert thoughtpart "Near" thought=APM_Thought_SirenSong min=5.9 max=6.1 expect=present

assert pawn "Far" hediff=APM_Hediff_SirenSong expect=absent
assert pawn "Far" need=Joy max=0.32 expect=present
assert pawn "Far" capacity=Moving max=1.02 expect=present
assert pawn "Far" thought=APM_Thought_SirenSong expect=absent
assert pawn "Siren" hediff=APM_Hediff_SirenSong expect=absent
assert log clean
