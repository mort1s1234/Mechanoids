rwtest 1
test "Conqueror unity grows with allies, ultimate sacrifice buffs and spends caster" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires mod=Mortis.ApexMechanoids
requires dlc=Biotech
spawn Pawn:APM_Mech_Conqueror_DMR name="DMR"
pacify "DMR"
tick 600 note="two 250 tick recount intervals from a random offset"
assert pawn "DMR" hediff=APM_Hediff_Unity expect=present
assert pawn "DMR" hediff=APM_Hediff_Unity severity max=0.05 expect=present
assert pawn "DMR" stat=MoveSpeed min=4.25 max=4.32 expect=present

spawn Pawn:APM_Mech_Conqueror_SMG faction=player name="Colony SMG"
pacify "Colony SMG"
tick 600 note="two recount intervals; a colony Conqueror is no ally of a hostile one"
assert pawn "DMR" hediff=APM_Hediff_Unity severity max=0.05 expect=present

spawn Pawn:APM_Mech_Conqueror_AR name="AR"
pacify "AR"
spawn Pawn:APM_Mech_Conqueror_SMG name="SMG"
pacify "SMG"
waitfor pawn "DMR" hediff=APM_Hediff_Unity severity min=0.19 max=0.21 ticks=500 expect=present
waitfor pawn "AR" hediff=APM_Hediff_Unity severity min=0.19 max=0.21 ticks=500 expect=present
assert pawn "DMR" stat=MoveSpeed min=4.33 max=4.40 expect=present

spawn Pawn:APM_Mech_Conqueror_DMR at 60,0 faction=player name="Caster"
spawn Pawn:APM_Mech_Conqueror_AR at 64,0 faction=player name="Near"
room at 74,-1 size=3,3 door=none roof=false name="cage"
spawn Pawn:APM_Mech_Conqueror_SMG at 75,0 faction=player name="Far"
spawn Pawn:APM_Mech_Pulse at 60,4 faction=player name="Pulse"
spawn Pawn:Colonist at 54,-6 name="Mechanitor"
draft "Mechanitor"
overseer "Caster" by="Mechanitor" now=true
draft "Caster"

assert pawn "Near" capacity=Moving min=0.95 max=1.05 expect=present
assert pawn "Far" near="Caster" min=14 expect=present
select "Caster"
gizmo "Ultimate sacrifice" expect=allowed
deselect

waitfor pawn "Near" hediff=APM_Hediff_UltimateSacrifice ticks=480 expect=present
assert pawn "Near" capacity=Moving min=1.2 max=1.3 expect=present
assert pawn "Near" capacity=Consciousness min=1.05 max=1.15 expect=present
waitfor pawn "Caster" dead ticks=120 expect=present

assert pawn "Far" hediff=APM_Hediff_UltimateSacrifice expect=absent
assert pawn "Pulse" hediff=APM_Hediff_UltimateSacrifice expect=absent
assert log clean
