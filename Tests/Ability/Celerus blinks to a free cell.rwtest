rwtest 1
test "Celerus blinks to a free cell" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires mod=Mortis.ApexMechanoids
requires dlc=Biotech
spawn Pawn:APM_Mech_Celerus at 0,0 faction=player name="Celerus"
spawn Pawn:Colonist at -4,0 name="Mechanitor"
draft "Mechanitor"
give "Mechanitor" need=Food value=1
overseer "Celerus" by="Mechanitor"
draft "Celerus"
spawn Pawn:Colonist at 6,3 name="Bystander"
draft "Bystander"

select "Celerus"
gizmo "Blink" expect=allowed
target cell=6,3 expect=refused
assert thing "Celerus" at 6,3 expect=absent

assert thing "Celerus" at 10,-2 expect=absent
gizmo "Blink" expect=allowed
target cell=10,-2 expect=allowed
waitfor thing "Celerus" at 10,-2 ticks=120 expect=present
assert thing "Bystander" at 6,3 expect=present
gizmo "Blink" expect=disabled
deselect
assert log clean
