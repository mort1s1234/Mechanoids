rwtest 1
test "Weapons grant and take their abilities" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
spawn Pawn:Colonist at 0,0 name="Wielder"
draft "Wielder"
select "Wielder"
gizmo "Severing edge" expect=absent

equip "Wielder" thing=APM_Weapon_SeveringBlade now=true
assert pawn "Wielder" equipment=APM_Weapon_SeveringBlade expect=present
assert ability "Wielder" ability=APM_SeveringEdge range min=4.4 max=5.4
gizmo "Severing edge" expect=allowed
target cell=3,0 expect=allowed
waitfor casts "Wielder" ability=APM_SeveringEdge min=1 ticks=60
gizmo "Skip" expect=absent

equip "Wielder" thing=APM_Weapon_Skipblade now=true
assert pawn "Wielder" equipment=APM_Weapon_Skipblade expect=present
assert ability "Wielder" ability=APM_SkipbladeBlink range min=17.4 max=18.4
gizmo "Severing edge" expect=absent
gizmo "Skip" expect=allowed
target cell=8,0 expect=allowed
waitfor casts "Wielder" ability=APM_SkipbladeBlink min=1 ticks=60
assert text contains "APM" expect=absent
assert log clean
