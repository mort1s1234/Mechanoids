rwtest 1
test "Siren wardens prisoners - chat, food, release and execution" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires mod=Mortis.ApexMechanoids
requires dlc=Biotech
speed paused
room size=5,5 prison=true name="cell"
spawn Thing:Bed in="cell" faction=player
spawn Pawn:Colonist in="cell" name="Prisoner"
spawn Pawn:APM_Mech_Siren faction=player name="Siren"
spawn Pawn:APM_Mech_Lasher faction=player name="Lasher"
prisoner "Prisoner" resistance=10 mode=ReduceResistance

assert prisoner "Prisoner" secure expect=present
assert pawn "Prisoner" room=PrisonCell expect=present
assert reach "Siren" to="Prisoner" pathEndMode=Touch expect=present
assert pawn "Prisoner" resistance min=9.9 max=10.1 expect=present

work "Siren" giver=APM_SirenChatWithPrisoner on="Prisoner" expect=allowed
work "Lasher" giver=APM_SirenChatWithPrisoner on="Prisoner" expect=disabled

prisoner "Prisoner" mode=MaintainOnly
work "Siren" giver=APM_SirenChatWithPrisoner on="Prisoner" expect=absent

prisoner "Prisoner" mode=AttemptRecruit
work "Siren" giver=APM_SirenChatWithPrisoner on="Prisoner" expect=allowed

prisoner "Prisoner" mode=ReduceResistance
speed x1
job "Siren" giver=APM_SirenChatWithPrisoner on="Prisoner" until=done ticks=3000
assert pawn "Prisoner" resistance min=7.0 max=9.8 expect=present

give "Prisoner" need=Food value=0.05
spawn Thing:MealSimple at 6,6 count=5
work "Siren" giver=APM_SirenDeliverFoodToPrisoner on="Prisoner" expect=allowed
work "Lasher" giver=APM_SirenDeliverFoodToPrisoner on="Prisoner" expect=disabled

prisoner "Prisoner" mode=Release
work "Siren" giver=APM_SirenReleasePrisoner on="Prisoner" expect=allowed
work "Lasher" giver=APM_SirenReleasePrisoner on="Prisoner" expect=disabled

prisoner "Prisoner" mode=Execution
work "Lasher" giver=APM_SirenDoExecution on="Prisoner" expect=disabled
job "Siren" giver=APM_SirenDoExecution on="Prisoner" until=done ticks=2500
assert pawn "Prisoner" dead expect=present
assert log clean
