rwtest 1
test "Vassal resurrects a mech only while its overseer has bandwidth" project="Apex Mechanoids" created=2026-10-02T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
sky glow=1
room size=15,11 roof=false name="yard"
spawn Thing:WoodFiredGenerator in="yard" faction=player fueled=true
spawn Thing:MechGestator in="yard" faction=player name="gestator"
spawn Thing:Steel in="yard" count=25
spawn Pawn:Colonist in="yard" name="Mechanitor"
spawn Pawn:APM_Mech_Vassal in="yard" faction=player name="Vassal"
spawn Pawn:APM_Mech_Vassal in="yard" faction=player name="Second vassal"
spawn Pawn:Mech_Lifter in="yard" faction=player name="Fallen"
overseer "Vassal" by="Mechanitor" now=true
waitfor power "gestator" ticks=250 expect=present
assert pawn "Mechanitor" stat=MechBandwidth min=6 max=6 expect=present

damage "Fallen" amount=999
assert pawn "Fallen" dead expect=present
assert thing Corpse_Mech_Lifter expect=present

select "gestator"
tab "Bills"
click "Add bill"
menu "Resurrect light mechanoid" expect=allowed
deselect

work "Vassal" giver=DoBillsMechGestator on="gestator" forced=true expect=allowed

overseer "Second vassal" by="Mechanitor" now=true
work "Vassal" giver=DoBillsMechGestator on="gestator" forced=true expect=disabled reason="Not enough bandwidth" match=equals
assert log clean
